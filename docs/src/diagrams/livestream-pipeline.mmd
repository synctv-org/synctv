flowchart LR
  Publisher[Publisher<br/>OBS / WHIP / RTMP]
  Ingest[WHIP or RTMP ingest<br/>auth + publish registry]
  External[External pull<br/>WHEP / RTSP / HTTP-FLV]
  Hub[StreamHub<br/>RTP + remuxed frames]
  WHEP[WHEP session<br/>WebRTC playback]
  FLV[HTTP-FLV session<br/>low latency]
  Remux[HLS remuxer<br/>segments + playlist state]
  Storage[(HLS storage<br/>memory / file / S3)]
  Playlist[HLS playlist route]
  Segment[HLS segment route]
  Viewer[Viewer client]
  Registry[(publisher registry<br/>in-memory or Redis)]
  Remote[Remote node<br/>WHEP/HLS/FLV request]
  RTPRelay[Publisher-node<br/>RTP gRPC relay]
  HLSProxy[Publisher-node<br/>HLS gRPC proxy]

  Publisher --> Ingest --> Hub
  External --> Hub
  Ingest --> Registry
  External --> Registry
  Hub --> WHEP --> Viewer
  Hub --> FLV --> Viewer
  Hub --> Remux --> Storage
  Viewer --> Playlist --> Storage
  Viewer --> Segment --> Storage
  Remote -. lookup publisher .-> Registry
  Remote -. frame relay .-> Hub
  Remote -. RTP relay .-> RTPRelay
  RTPRelay -. RTP packets .-> Hub
  Remote -. playlist/segment proxy .-> HLSProxy
  HLSProxy -. local read .-> Storage
