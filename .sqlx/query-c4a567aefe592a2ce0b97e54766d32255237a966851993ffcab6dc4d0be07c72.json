  "query": "\n        SELECT id, created_at\n        FROM chat_messages\n        WHERE deletion_source = 'user'\n          AND deleted_at <= NOW() - make_interval(days => $1)\n        ORDER BY deleted_at ASC, created_at ASC, id ASC\n        LIMIT $2\n        FOR UPDATE SKIP LOCKED\n        ",
