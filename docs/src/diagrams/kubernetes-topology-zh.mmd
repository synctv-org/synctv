    GRPCIngress[gRPC Ingress<br/>backend-protocol: GRPC]
    HTTPService[HTTP Service]
    GRPCService[gRPC Service]
  end

  subgraph Workload["SyncTV 工作负载"]
    PodA[SyncTV Pod]
    PodB[SyncTV Pod]
    PodC[SyncTV Pod]
  end

  PG[(PostgreSQL)]
  Redis[(Redis)]
  HLS[(可选共享 HLS 存储<br/>或发布节点代理)]
