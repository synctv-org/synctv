  "query": "\n            SELECT event_id AS \"event_id?\", sequence AS \"sequence!\"\n            FROM chat_message_events\n            WHERE room_id = $1\n              AND event_type = ANY($2::text[])\n              AND (payload #>> '{message,message,messageType}') = ANY($3::text[])\n            ORDER BY sequence DESC\n            LIMIT 1\n            ",
