# SyncTV Environment Variables
#
# Copy this file to .env and fill in your values
# See docs/ENVIRONMENT_VARIABLES.md for complete documentation
#
# SECURITY WARNING: Never commit .env with real secrets to git!
# For file-mounted secrets, prefer the *_file keys in synctv.yaml / synctv.example.yaml.
# Environment variables themselves do not support generic *_FILE variants.

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Database Connection (Required)
# Format: postgresql://[user[:password]@][host][:port][/dbname]
SYNCTV_DATABASE_URL=postgresql://synctv:synctv@localhost:5432/synctv

# JWT Secret (Required)
# MUST have at least 256-bit entropy (mixed case, numbers, special chars)
# Generate with: openssl rand -base64 48
# Prefer jwt.secret_file in synctv.yaml when using mounted secret files.
SYNCTV_JWT_SECRET=REPLACE_WITH_YOUR_OWN_SECRET

# ============================================================================
# RECOMMENDED CONFIGURATION
# ============================================================================

# Redis (Recommended for production, Required for OAuth2)
# Format: redis://[username:password@]host[:port][/database]
SYNCTV_REDIS_URL=redis://localhost:6379

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server Bind Address
SYNCTV_SERVER_HOST=0.0.0.0

# Unified API Port (HTTP/1 + HTTP/2 gRPC)
SYNCTV_SERVER_PORT=8080

# Enable Prometheus Metrics Endpoint
SYNCTV_METRICS_ENABLED=false

# Enable gRPC Reflection (for grpcurl)
SYNCTV_SERVER_ENABLE_REFLECTION=false

# Graceful Shutdown Timeout (seconds)
SYNCTV_SERVER_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# ============================================================================
# TIME CONFIGURATION
# ============================================================================

# Default IANA timezone for human-readable output and local datetime parsing.
# Examples: UTC, Asia/Shanghai, America/New_York
# Leave unset to fall back to TZ or system timezone.
# SYNCTV_TIME_TIMEZONE=UTC

# Standard timezone environment fallback used when SYNCTV_TIME_TIMEZONE
# is not set. Prefer SYNCTV_TIME_TIMEZONE for application-specific control.
# TZ=UTC

# ============================================================================
# CLUSTER CONFIGURATION (Multi-Replica Deployments)
# ============================================================================

# Cluster Shared Secret — REQUIRED when cluster mode is enabled.
# Startup fails if SYNCTV_CLUSTER_ENABLED=true and this is empty.
# Generate with: openssl rand -hex 32
# Prefer server.cluster_secret_file in synctv.yaml when using mounted secret files.
# SYNCTV_SERVER_CLUSTER_SECRET=

# Advertise Host (public hostname for this replica)
# SYNCTV_SERVER_ADVERTISE_HOST=

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Connection Pool Settings
SYNCTV_DATABASE_MAX_CONNECTIONS=20
SYNCTV_DATABASE_MIN_CONNECTIONS=5

# Timeouts (seconds)
SYNCTV_DATABASE_CONNECT_TIMEOUT_SECONDS=30
SYNCTV_DATABASE_IDLE_TIMEOUT_SECONDS=600
SYNCTV_DATABASE_MAX_LIFETIME_SECONDS=1800

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Key Prefix (useful for shared Redis instances)
SYNCTV_REDIS_KEY_PREFIX=synctv:

# ============================================================================
# JWT CONFIGURATION
# ============================================================================

# Token Validity Periods
SYNCTV_JWT_ACCESS_TOKEN_DURATION_HOURS=1
SYNCTV_JWT_REFRESH_TOKEN_DURATION_DAYS=30
SYNCTV_JWT_GUEST_TOKEN_DURATION_HOURS=4

# Clock Skew Tolerance (seconds)
SYNCTV_JWT_CLOCK_SKEW_LEEWAY_SECS=60

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log Level: trace, debug, info, warn, error
SYNCTV_LOGGING_LEVEL=info

# Log Format: pretty (human-readable) or json (structured)
SYNCTV_LOGGING_FORMAT=pretty

# Optional: Fine-grained tracing filter. When set, this overrides
# SYNCTV_LOGGING_LEVEL for tracing target selection.
# SYNCTV_LOGGING_FILTER=info,synctv=debug,synctv_core::service=trace

# Include panic backtraces in stderr output
SYNCTV_LOGGING_BACKTRACE=false

# ============================================================================
# WEBRTC CONFIGURATION
# ============================================================================

# WebRTC Mode: signaling_only or peer_to_peer
SYNCTV_WEBRTC_MODE=peer_to_peer

# Built-in STUN Server Port
SYNCTV_WEBRTC_STUN_PORT=3478

# Enable Built-in STUN Server
SYNCTV_WEBRTC_ENABLE_BUILTIN_STUN=true

# External STUN Address (Required for cluster mode)
# Format: public-ip:port
# SYNCTV_WEBRTC_STUN_EXTERNAL_ADDR=

# ============================================================================
# LIVESTREAM CONFIGURATION
# ============================================================================

# RTMP Server Port
SYNCTV_LIVESTREAM_RTMP_PORT=1935

# GOP Cache Size (for instant playback)
SYNCTV_LIVESTREAM_GOP_CACHE_SIZE=2

# Stream Timeouts
SYNCTV_LIVESTREAM_STREAM_TIMEOUT_SECONDS=300
SYNCTV_LIVESTREAM_CLEANUP_CHECK_INTERVAL_SECONDS=60

# Pull Stream Retry Settings
SYNCTV_LIVESTREAM_PULL_MAX_RETRIES=10
SYNCTV_LIVESTREAM_PULL_INITIAL_BACKOFF_MS=1000
SYNCTV_LIVESTREAM_PULL_MAX_BACKOFF_MS=30000

# ============================================================================
# MANAGEMENT CONFIGURATION
# ============================================================================

# Local management endpoint for `synctv` operational commands.
# On Unix platforms, the default transport is `unix` with a runtime socket path.
# TCP transport requires SYNCTV_MANAGEMENT_AUTH_TOKEN.
# Unix transport can also use it, but defaults to empty and may rely on socket permissions.
# Prefer management.auth_token_file in synctv.yaml when using mounted secret files.
# SYNCTV_MANAGEMENT_ENABLED=true
# SYNCTV_MANAGEMENT_TRANSPORT=unix
# SYNCTV_MANAGEMENT_PORT=50052
# SYNCTV_MANAGEMENT_UNIX_SOCKET_PATH=/absolute/path/to/synctv.sock
# SYNCTV_MANAGEMENT_AUTH_TOKEN=replace-with-a-random-secret

# ============================================================================
# OAUTH2 CONFIGURATION
# ============================================================================

# OAuth2 Redirect Scheme (http or https)
SYNCTV_OAUTH2_REDIRECT_SCHEME=http

# NOTE: OAuth2 provider details (client_id, client_secret) must be
# configured in synctv.yaml / synctv.yml / synctv.json / synctv.toml,
# not environment variables.
# See docs/ENVIRONMENT_VARIABLES.md for details.

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# SMTP Server
# Prefer email.smtp_password_file in synctv.yaml when using mounted secret files.
# SYNCTV_EMAIL_SMTP_HOST=smtp.gmail.com
# SYNCTV_EMAIL_SMTP_PORT=587
# SYNCTV_EMAIL_SMTP_USERNAME=
# SYNCTV_EMAIL_SMTP_PASSWORD=
# SYNCTV_EMAIL_FROM_EMAIL=noreply@synctv.example.com
# SYNCTV_EMAIL_FROM_NAME=SyncTV
# SYNCTV_EMAIL_USE_TLS=true

# ============================================================================
# BOOTSTRAP CONFIGURATION
# ============================================================================

# Create Root User on First Start
# Set to true only when you also provide SYNCTV_BOOTSTRAP_ROOT_PASSWORD.
SYNCTV_BOOTSTRAP_CREATE_ROOT_USER=false

# Root User Credentials
SYNCTV_BOOTSTRAP_ROOT_USERNAME=root

# Root Password
# Prefer bootstrap.root_password_file in synctv.yaml when using mounted secret files.
# SYNCTV_BOOTSTRAP_ROOT_PASSWORD=

# ============================================================================
# CONNECTION LIMITS
# ============================================================================

# Maximum WebSocket Connections per User
SYNCTV_CONNECTION_LIMITS_MAX_PER_USER=5

# Maximum Connections per Room
SYNCTV_CONNECTION_LIMITS_MAX_PER_ROOM=200

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================

# Most users don't need to change these settings.
# See docs/ENVIRONMENT_VARIABLES.md for more options.

# ============================================================================
# VALIDATION
# ============================================================================

# After setting up your environment, validate the configuration:
#   cargo run -p synctv -- config validate
#
# See docs/config-validation.md for details.
