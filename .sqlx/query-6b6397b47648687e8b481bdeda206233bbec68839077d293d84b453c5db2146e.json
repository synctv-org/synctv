  "query": "\n            SELECT event_id, sequence, resource_type, event_type, payload\n            FROM room_resource_events\n            WHERE room_id = $1\n              AND sequence > $2\n              AND resource_type = ANY($3::TEXT[])\n            ORDER BY sequence ASC\n            LIMIT $4\n            ",
