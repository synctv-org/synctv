{
  "db_name": "PostgreSQL",
  "query": "\n            WITH picked AS (\n                SELECT id\n                FROM realtime_outbox\n                WHERE status = 1\n                  AND next_retry_at <= NOW()\n                ORDER BY next_retry_at, created_at, id\n                LIMIT $1\n                FOR UPDATE SKIP LOCKED\n            )\n            UPDATE realtime_outbox o\n            SET status = $2,\n                locked_by = $3,\n                locked_at = NOW()\n            FROM picked\n            WHERE o.id = picked.id\n            RETURNING\n                o.id,\n                o.aggregate_type,\n                o.aggregate_id,\n                o.event_type,\n                o.event_version,\n                o.aggregate_version,\n                o.payload AS \"payload!: sqlx::types::Json<RealtimeEvent>\",\n                o.status,\n                o.attempts,\n                o.next_retry_at,\n                o.locked_by,\n                o.locked_at,\n                o.created_at,\n                o.dispatched_at,\n                o.last_error\n            ",
