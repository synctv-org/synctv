  "query": "\n            SELECT id,\n                   user_id as \"user_id: UserId\",\n                   type as \"notification_type: NotificationType\",\n                   title,\n                   content,\n                   data as \"data!: serde_json::Value\",\n                   is_read,\n                   created_at,\n                   updated_at\n            FROM notifications\n            WHERE id = $1\n              AND created_at >= $2\n              AND created_at <= $3\n            ",
