  GRPCService --> PodB
  GRPCService --> PodC
  PodA --> PG
  PodB --> PG
  PodC --> PG
  PodA --> Redis
  PodB --> Redis
  PodC --> Redis
  PodA --> HLS
  PodB --> HLS
  PodC --> HLS
  PodA --> External
  PodB --> External
  PodC --> External
