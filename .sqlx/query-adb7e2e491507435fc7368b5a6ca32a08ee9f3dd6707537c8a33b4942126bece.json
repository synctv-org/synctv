  "db_name": "PostgreSQL",
  "query": "\n             UPDATE rooms\n             SET name = $2, description = $3, closed_at = $4, version = version + 1\n             WHERE id = $1 AND deleted_at IS NULL AND version = $5\n             RETURNING id AS \"id: RoomId\",\n                       name,\n                       description,\n                       created_by AS \"created_by: UserId\",\n                       closed_at,\n                       false AS \"is_banned!\",\n                       created_at,\n                       updated_at,\n                       deleted_at,\n                       version,\n                       last_activity_at\n            ",
