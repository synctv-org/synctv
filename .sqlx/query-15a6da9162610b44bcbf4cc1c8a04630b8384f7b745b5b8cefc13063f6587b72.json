  "db_name": "PostgreSQL",
  "query": "\n            SELECT sequence, event_id, room_id, actor_user_id, payload AS event_payload,\n                   occurred_at\n            FROM chat_message_events\n            WHERE event_type = 'chat_message_created'\n              AND room_id = $1\n              AND message_id = $2\n              AND message_created_at = $3\n            ORDER BY sequence ASC\n            LIMIT 1\n            ",
