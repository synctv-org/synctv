<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SyncTV Login Code</title>
</head>
<body style="margin:0;padding:0;background:#f4f7fb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f7fb;padding:24px 12px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border-radius:16px;padding:32px;box-shadow:0 12px 32px rgba(15,23,42,0.08);">
                    <tr>
                        <td>
                            <h1 style="margin:0 0 16px;font-size:28px;line-height:1.2;">Your SyncTV login code</h1>
                            <p style="margin:0 0 16px;font-size:16px;line-height:1.6;">
                                Use the code below to sign in to SyncTV. This code expires in {{expires_in}}.
                            </p>
                            <div style="margin:24px 0;padding:18px 20px;border-radius:12px;background:#eef4ff;border:1px solid #cfe0ff;font-size:28px;font-weight:700;letter-spacing:0.18em;text-align:center;">
                                {{token}}
                            </div>
                            <p style="margin:0 0 12px;font-size:14px;line-height:1.6;color:#4b5563;">
                                If you requested multiple login codes, each unused code remains valid until it expires or is used.
                            </p>
                            <p style="margin:0;font-size:14px;line-height:1.6;color:#4b5563;">
                                If you did not request this login, you can ignore this email.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
