  "db_name": "PostgreSQL",
  "query": "\n                SELECT id,\n                       room_id as \"room_id: RoomId\",\n                       user_id as \"user_id: UserId\",\n                       content,\n                       message_type,\n                       created_at\n                FROM chat_messages\n                WHERE room_id = $1 AND (created_at, id) < ($2, $3)\n                ORDER BY created_at DESC, id DESC\n                LIMIT $4::int4\n                ",
