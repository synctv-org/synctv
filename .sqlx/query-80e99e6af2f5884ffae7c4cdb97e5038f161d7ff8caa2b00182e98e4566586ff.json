  "query": "\n            SELECT\n                id AS \"id: EmailRegistrationTokenId\",\n                token_hash,\n                username,\n                email,\n                expires_at,\n                used_at,\n                created_at\n            FROM auth_email_registration_tokens\n            WHERE token_hash = $1\n              AND used_at IS NULL\n              AND expires_at > CURRENT_TIMESTAMP\n            FOR UPDATE\n            ",
