  "query": "SELECT m.id AS \"id: MediaId\", m.room_id AS \"room_id: RoomId\"\n             FROM media m\n             JOIN rooms r ON r.id = m.room_id\n             WHERE m.creator_id = $1\n               AND r.deleted_at IS NULL\n             ORDER BY m.room_id, m.id",
