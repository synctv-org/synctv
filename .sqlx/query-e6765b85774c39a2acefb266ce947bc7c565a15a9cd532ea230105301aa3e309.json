  "query": "\n            SELECT id,\n                   actor_id AS \"actor_id?: UserId\",\n                   actor_username,\n                   action,\n                   target_type,\n                   target_id,\n                   details AS \"details?: AuditDetails\",\n                   ip_address,\n                   user_agent,\n                   created_at\n            FROM audit_logs\n            WHERE id = $1 AND created_at >= NOW() - INTERVAL '365 days'\n            ",
