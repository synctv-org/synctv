  "query": "\n            UPDATE auth_email_tokens\n            SET used_at = CURRENT_TIMESTAMP\n            WHERE token = $1\n              AND token_type = $2\n              AND used_at IS NULL\n              AND expires_at > CURRENT_TIMESTAMP\n            RETURNING id, token, user_id as \"user_id: UserId\", token_type, expires_at, used_at, created_at\n            ",
