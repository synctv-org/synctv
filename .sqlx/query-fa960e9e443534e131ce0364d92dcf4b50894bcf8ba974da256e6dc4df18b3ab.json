  "query": "\n            UPDATE auth_email_tokens\n            SET used_at = $4\n            WHERE token = $1\n              AND token_type = $2\n              AND user_id = $3\n              AND used_at IS NULL\n              AND expires_at > $4\n            RETURNING id, token, user_id as \"user_id: UserId\", token_type, expires_at, used_at, created_at\n            ",
