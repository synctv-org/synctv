  "query": "\n            SELECT id AS \"id: RoomId\",\n                   requested_by AS \"requested_by: UserId\",\n                   name,\n                   description,\n                   requested_at\n            FROM room_creation_requests\n            WHERE reviewed_at IS NULL AND status = $1\n            ORDER BY requested_at DESC, id DESC\n            LIMIT $2 OFFSET $3\n            ",
