  "query": "\n                UPDATE chat_messages\n                SET deleted_at = CURRENT_TIMESTAMP,\n                    deletion_source = $2,\n                    deleted_owner_id = $1,\n                    version = version + 1\n                WHERE user_id = $1\n                  AND deleted_at IS NULL\n                RETURNING id, room_id AS \"room_id!: RoomId\", message_type AS \"message_type!: ChatMessageType\", version, created_at, deleted_at\n                ",
