  "query": "\n        SELECT id, created_at\n        FROM chat_messages\n        WHERE created_at <= NOW() - make_interval(days => $1)\n        ORDER BY created_at ASC, id ASC\n        LIMIT $2\n        FOR UPDATE SKIP LOCKED\n        ",
