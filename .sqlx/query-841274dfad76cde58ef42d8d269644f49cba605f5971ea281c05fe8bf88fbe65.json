  "query": "\n            SELECT event_id AS \"event_id!\",\n                   sequence AS \"sequence!\",\n                   payload AS \"event_payload?: sqlx::types::Json<RoomResourceEventPayload>\",\n                   occurred_at AS \"occurred_at!\"\n            FROM room_resource_events\n            WHERE room_id = $1\n              AND resource_type = $2\n              AND event_type = $3\n              AND resource_id = $4\n            ORDER BY sequence DESC\n            LIMIT 1\n            ",
