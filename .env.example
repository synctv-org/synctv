# SyncTV Environment Variables
#
# Copy this file to .env and fill in your values
# See docs/ENVIRONMENT_VARIABLES.md for complete documentation
#
# SECURITY WARNING: Never commit .env with real secrets to git!

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Database Connection (Required)
# Format: postgresql://[user[:password]@][host][:port][/dbname]
SYNCTV_DATABASE_URL=postgresql://synctv:synctv@localhost:5432/synctv

# JWT Secret (Required)
# MUST have at least 256-bit entropy (mixed case, numbers, special chars)
# Generate with: openssl rand -base64 48
SYNCTV_JWT_SECRET=REPLACE_WITH_YOUR_OWN_SECRET

# ============================================================================
# RECOMMENDED CONFIGURATION
# ============================================================================

# Redis (Recommended for production, Required for OAuth2)
# Format: redis://[username:password@]host[:port][/database]
SYNCTV_REDIS_URL=redis://localhost:6379

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server Bind Address
SYNCTV_SERVER_HOST=0.0.0.0

# gRPC Port
SYNCTV_SERVER_GRPC_PORT=50051

# HTTP/WebSocket Port
SYNCTV_SERVER_HTTP_PORT=8080

# Enable Prometheus Metrics Endpoint
SYNCTV_SERVER_METRICS_ENABLED=false

# Enable gRPC Reflection (for grpcurl)
SYNCTV_SERVER_ENABLE_REFLECTION=false

# Graceful Shutdown Timeout (seconds)
SYNCTV_SERVER_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# Disable Token in WebSocket Query String (force header/cookie only)
SYNCTV_SERVER_DISABLE_WS_TOKEN_QUERY=false

# ============================================================================
# CLUSTER CONFIGURATION (Multi-Replica Deployments)
# ============================================================================

# Cluster Shared Secret — REQUIRED when Redis is configured.
# Startup fails if SYNCTV_REDIS_URL is set but this is empty.
# Generate with: openssl rand -hex 32
# SYNCTV_SERVER_CLUSTER_SECRET=

# Advertise Host (public hostname for this replica)
# SYNCTV_SERVER_ADVERTISE_HOST=

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Connection Pool Settings
SYNCTV_DATABASE_MAX_CONNECTIONS=20
SYNCTV_DATABASE_MIN_CONNECTIONS=5

# Timeouts (seconds)
SYNCTV_DATABASE_CONNECT_TIMEOUT_SECONDS=30
SYNCTV_DATABASE_IDLE_TIMEOUT_SECONDS=600
SYNCTV_DATABASE_MAX_LIFETIME_SECONDS=1800

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Key Prefix (useful for shared Redis instances)
SYNCTV_REDIS_KEY_PREFIX=synctv:

# ============================================================================
# JWT CONFIGURATION
# ============================================================================

# Token Validity Periods
SYNCTV_JWT_ACCESS_TOKEN_DURATION_HOURS=24
SYNCTV_JWT_REFRESH_TOKEN_DURATION_DAYS=30
SYNCTV_JWT_GUEST_TOKEN_DURATION_HOURS=1

# Clock Skew Tolerance (seconds)
SYNCTV_JWT_CLOCK_SKEW_LEEWAY_SECS=30

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log Level: trace, debug, info, warn, error
SYNCTV_LOGGING_LEVEL=info

# Log Format: pretty (human-readable) or json (structured)
SYNCTV_LOGGING_FORMAT=pretty

# Alternative: Use RUST_LOG for fine-grained control
# RUST_LOG=synctv=debug,synctv_core::service=trace

# ============================================================================
# WEBRTC CONFIGURATION
# ============================================================================

# WebRTC Mode: signaling_only or peer_to_peer
SYNCTV_WEBRTC_MODE=peer_to_peer

# Built-in STUN Server Port
SYNCTV_WEBRTC_STUN_PORT=3478

# Enable Built-in STUN Server
SYNCTV_WEBRTC_ENABLE_BUILTIN_STUN=true

# External STUN Address (Required for cluster mode)
# Format: public-ip:port
# SYNCTV_WEBRTC_STUN_EXTERNAL_ADDR=

# ============================================================================
# LIVESTREAM CONFIGURATION
# ============================================================================

# RTMP Server Port
SYNCTV_LIVESTREAM_RTMP_PORT=1935

# GOP Cache Size (for instant playback)
SYNCTV_LIVESTREAM_GOP_CACHE_SIZE=5

# Stream Timeouts
SYNCTV_LIVESTREAM_STREAM_TIMEOUT_SECONDS=300
SYNCTV_LIVESTREAM_CLEANUP_CHECK_INTERVAL_SECONDS=60

# Pull Stream Retry Settings
SYNCTV_LIVESTREAM_PULL_MAX_RETRIES=3
SYNCTV_LIVESTREAM_PULL_INITIAL_BACKOFF_MS=1000
SYNCTV_LIVESTREAM_PULL_MAX_BACKOFF_MS=30000
SYNCTV_LIVESTREAM_PULL_BACKOFF_MULTIPLIER=2.0

# ============================================================================
# OAUTH2 CONFIGURATION
# ============================================================================

# OAuth2 Redirect Scheme (http or https)
SYNCTV_OAUTH2_REDIRECT_SCHEME=http

# NOTE: OAuth2 provider details (client_id, client_secret) must be
# configured in config.yaml, not environment variables.
# See docs/ENVIRONMENT_VARIABLES.md for details.

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# SMTP Server
# SYNCTV_EMAIL_SMTP_HOST=smtp.gmail.com
# SYNCTV_EMAIL_SMTP_PORT=587
# SYNCTV_EMAIL_SMTP_USERNAME=
# SYNCTV_EMAIL_SMTP_PASSWORD=
# SYNCTV_EMAIL_FROM_ADDRESS=noreply@synctv.example.com
# SYNCTV_EMAIL_FROM_NAME=SyncTV
# SYNCTV_EMAIL_USE_TLS=true

# ============================================================================
# BOOTSTRAP CONFIGURATION
# ============================================================================

# Create Root User on First Start
SYNCTV_BOOTSTRAP_CREATE_ROOT_USER=true

# Root User Credentials
SYNCTV_BOOTSTRAP_ROOT_USERNAME=root
SYNCTV_BOOTSTRAP_ROOT_EMAIL=root@localhost

# Root Password (if empty, a random password will be generated)
# SYNCTV_BOOTSTRAP_ROOT_PASSWORD=

# ============================================================================
# CONNECTION LIMITS
# ============================================================================

# Maximum WebSocket Connections per User
SYNCTV_CONNECTION_LIMITS_MAX_WEBSOCKET_CONNECTIONS_PER_USER=10

# Maximum Connections per Room
SYNCTV_CONNECTION_LIMITS_MAX_ROOM_CONNECTIONS=1000

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================

# Most users don't need to change these settings.
# See docs/ENVIRONMENT_VARIABLES.md for more options.

# ============================================================================
# VALIDATION
# ============================================================================

# After setting up your environment, validate the configuration:
#   cargo run --bin validate-config
#
# Or:
#   ./scripts/validate-config.sh
#
# See docs/config-validation.md for details.
