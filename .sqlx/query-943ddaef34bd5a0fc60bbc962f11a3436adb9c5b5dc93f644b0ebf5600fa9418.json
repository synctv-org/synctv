  "query": "SELECT p.id AS \"id: PlaylistId\", p.room_id AS \"room_id: RoomId\"\n             FROM playlists p\n             JOIN rooms r ON r.id = p.room_id\n             WHERE p.creator_id = $1\n               AND p.deleted_at IS NULL\n               AND r.deleted_at IS NULL\n             ORDER BY p.room_id, p.id",
